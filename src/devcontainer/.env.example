DEVCONTAINER_CONTROL_PORT=9000
DEVCONTAINER_DOCS_PORT=999

# Application ports are configured per Compose instance in the control UI.
# Do not use the same application port for two instances.

# Shared configuration for ALL managed development and production-like environments.
DEV_POSTGRES_USER=unnamed_tracking
DEV_POSTGRES_PASSWORD=debug-password
DEV_POSTGRES_DB=unnamed_tracking
DEV_SECRET_KEY=devcontainer-not-for-production
DEV_PRIMARY_USER_USERNAME=admin
DEV_PRIMARY_USER_EMAIL=admin@example.invalid
DEV_PRIMARY_USER_PASSWORD=debug-admin-password
DEV_AUTH_COOKIE_SECURE=false

# Example production image/tag when an instance uses image mode:
# ghcr.io/rosefall-a/unnamed_tracking_app:latest
