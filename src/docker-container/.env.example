# Production container example environment
UNNAMED_TRACKING_APP_VERSION=latest
UNNAMED_TRACKING_APP_PORT=8080

POSTGRES_USER=unnamed_tracking
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=unnamed_tracking

SECRET_KEY=replace-with-a-long-random-secret
PRIMARY_USER_USERNAME=admin
PRIMARY_USER_EMAIL=admin@example.com
PRIMARY_USER_PASSWORD=replace-with-a-strong-password

# Set true only when the public endpoint is HTTPS.
AUTH_COOKIE_SECURE=false

# Optional embedded TLS. Disabled by default.
# NGINX_TLS_ENABLED=false
# NGINX_TLS_CERTIFICATE=/etc/nginx/tls/tls.crt
# NGINX_TLS_PRIVATE_KEY=/etc/nginx/tls/tls.key
# NGINX_TLS_REDIRECT_HTTP=false
