# Production container example environment
UNNAMED_TRACKING_APP_VERSION=latest
UNNAMED_TRACKING_APP_PORT=8080

POSTGRES_USER=unnamed_tracking
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=unnamed_tracking

SECRET_KEY=replace-with-a-long-random-secret
PRIMARY_USER_USERNAME=admin
PRIMARY_USER_EMAIL=admin@example.com
PRIMARY_USER_PASSWORD=replace-with-a-strong-password

# Set true only when the public endpoint is HTTPS.
AUTH_COOKIE_SECURE=false

# Optional embedded TLS. Disabled by default.
# If TLS is enabled without certificate/key paths, an existing /etc/nginx/tls pair is used when present; otherwise a self-signed localhost certificate is generated.
# NGINX_TLS_ENABLED=false
# NGINX_TLS_CERTIFICATE=/etc/nginx/tls/tls.crt
# NGINX_TLS_PRIVATE_KEY=/etc/nginx/tls/tls.key
# NGINX_TLS_REDIRECT_HTTP=false

# Trust forwarded client-IP headers from local/private, CGNAT, and Cloudflare proxy ranges by default.
# Set NGINX_REALIP_TRUSTED_PROXIES to a space-separated list to completely replace that default.
# Set it to an empty value to disable trusted real-IP sources.
# NGINX_REALIP_HEADER=X-Forwarded-For
# NGINX_REALIP_TRUSTED_PROXIES=
